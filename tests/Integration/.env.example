# Copy to .env. Test values only, never reuse them on a real server.

# Read by the plugin from Phase 1 on the locale and remoto-jellymesh instances.
# Left commented out, the variable is absent from the containers, which is the
# "key missing" case from plan §3.1. It needs at least 32 characters. Generate
# one with:
#   openssl rand -base64 32
# JELLYMESH_SECRET_KEY=

# Optional. Sets the federated folder and locks the field on the plugin page.
# Left commented out, because the UI checks choose the folder on the page. Add it
# to the environment of the instance in docker-compose.yml to use it.
# JELLYMESH_FEDERATED_ROOT=/federata

# Host address for the three published ports.
BIND_ADDRESS=127.0.0.1
